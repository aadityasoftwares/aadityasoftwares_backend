{
    "name": "aaditya-softwares-backend",
    "version": "1.0.0",
    "description": "Aaditya Softwares - Internal Management System Backend",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --exec tsx src/server.ts",
        "build": "tsc",
        "db:init": "tsx src/scripts/initialize-database.ts",
        "db:init:verify": "tsx src/scripts/verify-database-initialization.ts",
        "test": "node --import tsx --test tests/*.test.mjs",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1098.0",
        "@aws-sdk/s3-request-presigner": "^3.1098.0",
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.8.1",
        "multer": "^2.2.0",
        "node-cron": "^4.6.0",
        "nodemailer": "^9.0.3",
        "pdfkit": "^0.15.0",
        "resend": "^6.20.0",
        "sharp": "^0.35.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.2",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.1",
        "@types/pdfkit": "^0.13.9",
        "nodemon": "^3.1.14",
        "prettier": "3.9.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}

